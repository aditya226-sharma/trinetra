# TriNetra — environment configuration.
# Copy to .env and adjust. All variables are optional unless noted.

# --- Analyzer backends -----------------------------------------------------
# TRINETRA_LLM_BACKEND=heuristic        # heuristic | claude | local
# ANTHROPIC_API_KEY=                    # required for the claude backend
# TRINETRA_LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# TRINETRA_LOCAL_LLM_MODEL=qwen2.5-coder:7b

# --- Store paths -----------------------------------------------------------
# TRINETRA_STORE_PATH=./data/trinetra.db
# TRINETRA_RAW_DIR=./data/raw

# --- Identity & auth -------------------------------------------------------
# TRINETRA_CLIENT_ID=trinetra-core
# AGENT_TOKEN=                           # shared X-Agent-Token for /api/ingest-events
# ADMIN_USER=admin                       # seeded on first start
# ADMIN_PASSWORD=                        # REQUIRED for any exposed deployment
# TRINETRA_JWT_SECRET=                   # omit to auto-generate + persist
# TRINETRA_RETENTION_DAYS=30             # 1/7/30/90/365/0

# --- Outbound email alerting ------------------------------------------------
# TRINETRA_SMTP_HOST=
# TRINETRA_SMTP_PORT=587
# TRINETRA_SMTP_FROM=soc@example.com
# TRINETRA_SMTP_TO=soc@example.com
# TRINETRA_SMTP_USER=
# TRINETRA_SMTP_PASS=

# --- Frontend build (set at build time) ---------------------------------------
# VITE_API_BASE=            # override API origin if the dashboard is served separately
# VITE_BASE=/               # base path, e.g. /trinetra/ for GitHub Pages
# VITE_OFFLINE_DEMO=0       # 1 renders the static demo snapshot without an API